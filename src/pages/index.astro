---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/layout/NavBar.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../features/home/Hero.astro";
import Ledger from "../features/home/Ledger.astro";
import About from "../features/home/About.astro";
import Products from "../features/home/Products.astro";
import WhyUs from "../features/home/WhyUs.astro";
import Industries from "../features/home/Industries.astro";
import Quality from "../features/home/Quality.astro";
import Global from "../features/home/Global.astro";
import Process from "../features/home/Process.astro";
import Gallery from "../features/home/Gallery.astro";
import FAQ from "../features/home/FAQ.astro";
import CTABanner from "../features/home/CTABanner.astro";
import Contact from "../features/home/Contact.astro";
import FloatingButtons from "../features/home/FloatingButtons.astro";
import Container from "../components/ui/Container.astro";
import "../styles/style.css";
---

<BaseLayout
  title="Venkatesh Cotton Corporation | Cotton Bale Manufacturer & Agricultural Commodity Supplier, India"
  description="Venkatesh Cotton Corporation manufactures premium cotton bales and trades maize, pulses and food grains across India, building long-term partnerships with domestic and international buyers."
>
  <header
    id="site-nav"
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  >
      <div class="nav-glass border-b border-black/5">
        <Container class="flex items-center justify-between h-20">
        <a href="#home" class="flex items-center gap-3">
          <span
            class="w-10 h-10 rounded-full bg-deep flex items-center justify-center"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M12 2C9 6 9 9 12 12C15 9 15 6 12 2Z" fill="#D8B876"
              ></path>
              <path d="M12 12C9 15 9 18 12 22C15 18 15 15 12 12Z" fill="#B8863B"
              ></path>
              <path d="M2 12C6 9 9 9 12 12C9 15 6 15 2 12Z" fill="#2F5D45"
              ></path>
              <path d="M22 12C18 9 15 9 12 12C15 15 18 15 22 12Z" fill="#12352A"
              ></path>
            </svg>
          </span>
          <span class="leading-tight">
            <span class="block font-display text-lg font-medium text-deep"
              >Venkatesh Cotton</span
            >
            <span class="block font-mono-label text-[10px] text-field uppercase"
              >Corporation</span
            >
          </span>
        </a>
        <NavBar />
        <div class="hidden lg:flex items-center gap-3">
          <a
            href="#contact"
            class="px-5 py-2.5 rounded-full bg-deep text-cotton text-sm font-medium hover:bg-deep-700 transition"
            >Request a Quote</a
          >
        </div>
        <button
          id="menu-btn"
          aria-label="Open menu"
          class="lg:hidden w-10 h-10 flex items-center justify-center"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#12352A"
            stroke-width="2"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </button>
        </Container>
      </div>
    <div
      id="mobile-menu"
      class="hidden lg:hidden bg-cotton border-b border-black/10 px-6 py-6 flex flex-col gap-4 text-ink/80 font-medium"
    >
      <a href="#about">About</a>
      <a href="#products">Products</a>
      <a href="#why-us">Why Us</a>
      <a href="#global">Global</a>
      <a href="#gallery">Gallery</a>
      <a href="#faq">FAQ</a>
      <a href="#contact" class="text-deep">Contact</a>
    </div>
  </header>

  <Hero />
  <Ledger />
  <About />

  <div class="weave-divider"></div>

  <Products />
  <WhyUs />
  <Industries />
  <Quality />
  <Global />
  <Process />
  <Gallery />
  <FAQ />
  <CTABanner />
  <Contact />
  <Footer />

  <FloatingButtons />

  <script is:inline src="/js/script.js"></script>
</BaseLayout>
