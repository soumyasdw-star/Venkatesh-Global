---
import Container from "../../components/ui/Container.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";
---

<section id="contact" class="py-28 lg:py-36 bg-cotton">
  <Container class="grid lg:grid-cols-5 gap-14">
    <div class="lg:col-span-3 reveal">
      <SectionTitle label="Contact" title="Tell us what you need" />
      <form
        class="mt-10 grid sm:grid-cols-2 gap-5"
        onsubmit="
            event.preventDefault();
            document
              .getElementById('form-success')
              .classList.remove('hidden');
            this.reset();
          "
      >
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-medium text-ink/60" for="f-name"
            >Name</label
          >
          <input
            id="f-name"
            required
            type="text"
            class="rounded-xl border border-black/10 px-4 py-3 bg-white"
          />
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-medium text-ink/60" for="f-company"
            >Company</label
          >
          <input
            id="f-company"
            type="text"
            class="rounded-xl border border-black/10 px-4 py-3 bg-white"
          />
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-medium text-ink/60" for="f-country"
            >Country</label
          >
          <input
            id="f-country"
            type="text"
            class="rounded-xl border border-black/10 px-4 py-3 bg-white"
          />
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-medium text-ink/60" for="f-email"
            >Email</label
          >
          <input
            id="f-email"
            required
            type="email"
            class="rounded-xl border border-black/10 px-4 py-3 bg-white"
          />
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-medium text-ink/60" for="f-phone"
            >Phone</label
          >
          <input
            id="f-phone"
            type="tel"
            class="rounded-xl border border-black/10 px-4 py-3 bg-white"
          />
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-medium text-ink/60" for="f-product"
            >Product Interested</label
          >
          <select
            id="f-product"
            class="rounded-xl border border-black/10 px-4 py-3 bg-white"
          >
            <option>Cotton Bales</option>
            <option>Maize</option>
            <option>Pulses</option>
            <option>Food Grains</option>
            <option>Other</option>
          </select>
        </div>
        <div class="flex flex-col gap-1.5 sm:col-span-2">
          <label class="text-xs font-medium text-ink/60" for="f-qty"
            >Quantity</label
          >
          <input
            id="f-qty"
            type="text"
            placeholder="e.g. 50 MT / month"
            class="rounded-xl border border-black/10 px-4 py-3 bg-white"
          />
        </div>
        <div class="flex flex-col gap-1.5 sm:col-span-2">
          <label class="text-xs font-medium text-ink/60" for="f-msg"
            >Message</label
          >
          <textarea
            id="f-msg"
            rows="4"
            class="rounded-xl border border-black/10 px-4 py-3 bg-white"
          ></textarea>
        </div>
        <div class="sm:col-span-2">
          <button
            type="submit"
            class="px-8 py-3.5 rounded-full bg-deep text-cotton font-semibold text-sm hover:bg-deep-700 transition"
          >
            Send Inquiry
          </button>
          <p id="form-success" class="hidden mt-4 text-sm text-field">
            Thank you — your inquiry has been noted. Our team will get back to
            you shortly.
          </p>
        </div>
      </form>
    </div>

    <div class="lg:col-span-2 reveal">
      <div
        class="rounded-3xl overflow-hidden bg-deep-100 h-56 flex items-center justify-center bg-deep-900/5 border border-black/10"
      >
        <p class="text-xs font-mono-label uppercase text-ink/40">
          Map placeholder
        </p>
      </div>
      <div class="mt-8 space-y-5 text-sm">
        <div>
          <p class="text-ink/50 text-xs uppercase font-mono-label">
            WhatsApp
          </p>
          <p class="text-deep font-medium mt-1">+91 00000 00000</p>
        </div>
        <div>
          <p class="text-ink/50 text-xs uppercase font-mono-label">Email</p>
          <p class="text-deep font-medium mt-1">info@venkateshcotton.com</p>
        </div>
        <div>
          <p class="text-ink/50 text-xs uppercase font-mono-label">Phone</p>
          <p class="text-deep font-medium mt-1">+91 00000 00000</p>
        </div>
        <div>
          <p class="text-ink/50 text-xs uppercase font-mono-label">
            Business Hours
          </p>
          <p class="text-deep font-medium mt-1">
            Mon &ndash; Sat, 9:30 AM &ndash; 6:30 PM IST
          </p>
        </div>
        <div class="flex gap-3 pt-2">
          <a
            href="#"
            aria-label="LinkedIn"
            class="w-10 h-10 rounded-full border border-black/10 flex items-center justify-center hover:border-deep transition"
            >in</a
          >
          <a
            href="#"
            aria-label="Instagram"
            class="w-10 h-10 rounded-full border border-black/10 flex items-center justify-center hover:border-deep transition"
            >ig</a
          >
          <a
            href="#"
            aria-label="Facebook"
            class="w-10 h-10 rounded-full border border-black/10 flex items-center justify-center hover:border-deep transition"
            >fb</a
          >
        </div>
      </div>
    </div>
  </Container>
</section>
