---
import Container from "../../components/ui/Container.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";
---

<section
  id="global"
  class="py-28 lg:py-36 bg-harborgrad text-cotton relative overflow-hidden"
>
  <Container class="relative z-10">
    <div class="max-w-2xl reveal">
      <SectionTitle
        label="Global Business"
        title="Actively building international partnerships"
        titleClass="text-cotton"
      />
      <p class="mt-5 text-cotton/75">
        We are actively expanding our global presence and welcome business
        inquiries from international buyers, importers, and distributors
        seeking reliable agricultural commodity suppliers from India.
      </p>
    </div>

    <div class="mt-16 grid md:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <svg viewBox="0 0 600 320" class="w-full h-auto opacity-90">
          <rect x="0" y="0" width="600" height="320" fill="none"></rect>
          <g fill="#D8B876" opacity="0.9">
            <circle cx="330" cy="150" r="4"></circle>
            <circle cx="360" cy="170" r="3"></circle>
            <circle cx="300" cy="180" r="3"></circle>
            <circle cx="420" cy="130" r="3.2"></circle>
            <circle cx="440" cy="160" r="3"></circle>
            <circle cx="380" cy="200" r="3"></circle>
            <circle cx="230" cy="140" r="3"></circle>
            <circle cx="260" cy="120" r="3"></circle>
            <circle cx="480" cy="220" r="3.2"></circle>
            <circle cx="150" cy="110" r="3"></circle>
            <circle cx="120" cy="150" r="3"></circle>
          </g>
          <g
            stroke="#B8863B"
            stroke-width="1"
            opacity="0.55"
            fill="none"
            stroke-dasharray="4 5"
          >
            <path d="M330 150 Q 260 60 150 110"></path>
            <path d="M330 150 Q 400 60 420 130"></path>
            <path d="M330 150 Q 400 260 480 220"></path>
            <path d="M330 150 Q 250 220 230 140"></path>
          </g>
          <text
            x="330"
            y="145"
            fill="#FBFAF6"
            font-size="13"
            font-family="IBM Plex Mono, monospace"
            text-anchor="middle"
          >
            INDIA
          </text>
        </svg>
      </div>
      <div class="reveal grid grid-cols-2 gap-5">
        <div class="p-6 rounded-2xl border border-cotton/15">
          <p class="font-display text-xl">India</p>
          <p class="text-xs text-cotton/60 mt-1">
            Home base &amp; sourcing network
          </p>
        </div>
        <div class="p-6 rounded-2xl border border-cotton/15">
          <p class="font-display text-xl">Middle East</p>
          <p class="text-xs text-cotton/60 mt-1">
            Open for partnership inquiries
          </p>
        </div>
        <div class="p-6 rounded-2xl border border-cotton/15">
          <p class="font-display text-xl">South East Asia</p>
          <p class="text-xs text-cotton/60 mt-1">
            Open for partnership inquiries
          </p>
        </div>
        <div class="p-6 rounded-2xl border border-cotton/15">
          <p class="font-display text-xl">Africa</p>
          <p class="text-xs text-cotton/60 mt-1">
            Open for partnership inquiries
          </p>
        </div>
        <div class="p-6 rounded-2xl border border-cotton/15 col-span-2">
          <p class="font-display text-xl">Europe</p>
          <p class="text-xs text-cotton/60 mt-1">
            Open for partnership inquiries
          </p>
        </div>
      </div>
    </div>
  </Container>
</section>
