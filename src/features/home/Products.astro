---
import Container from "../../components/ui/Container.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";
---

<section id="products" class="py-28 lg:py-36 bg-deep text-cotton">
  <Container>
    <div class="max-w-2xl reveal">
      <SectionTitle
        label="Our Products"
        title="Premium cotton bales and a dependable line of agricultural commodities"
        titleClass="text-cotton"
      />
    </div>

    <div class="mt-16 grid md:grid-cols-2 gap-8">
      <!-- Cotton Bales -->
      <div class="reveal rounded-3xl overflow-hidden bg-deep-700 card-hover">
        <img
          src="https://images.unsplash.com/photo-1620200423727-8127f75d4f96?q=80&w=1600&auto=format&fit=crop"
          alt="Premium cotton bales stacked in a warehouse"
          class="w-full h-64 object-cover"
        />
        <div class="p-8">
          <h3 class="font-display text-2xl">Cotton Bales</h3>
          <p class="mt-3 text-cotton/70 text-sm leading-relaxed">
            Manufactured using premium raw cotton with high consistency across
            multiple grades. Reliable quality suited for industrial and
            textile industry supply.
          </p>
          <ul
            class="mt-4 flex flex-wrap gap-2 text-xs font-mono-label uppercase"
          >
            <li
              class="px-3 py-1 rounded-full border border-gold/40 text-gold-light"
            >
              Multiple Grades
            </li>
            <li
              class="px-3 py-1 rounded-full border border-gold/40 text-gold-light"
            >
              Textile Supply
            </li>
            <li
              class="px-3 py-1 rounded-full border border-gold/40 text-gold-light"
            >
              Industrial Use
            </li>
          </ul>
          <a
            href="#contact"
            class="mt-6 inline-block text-sm font-semibold text-gold-light hover:text-gold transition"
            >Request Quote &rarr;</a
          >
        </div>
      </div>

      <!-- Maize -->
      <div class="reveal rounded-3xl overflow-hidden bg-deep-700 card-hover">
        <img
          src="https://images.unsplash.com/photo-1601593768799-76e5e1b3e70d?q=80&w=1600&auto=format&fit=crop"
          alt="Maize field ready for harvest"
          class="w-full h-64 object-cover"
        />
        <div class="p-8">
          <h3 class="font-display text-2xl">Maize</h3>
          <p class="mt-3 text-cotton/70 text-sm leading-relaxed">
            Domestically sourced, high-quality maize available in food grade
            and feed grade, suited to industrial applications and bulk
            requirements.
          </p>
          <ul
            class="mt-4 flex flex-wrap gap-2 text-xs font-mono-label uppercase"
          >
            <li
              class="px-3 py-1 rounded-full border border-gold/40 text-gold-light"
            >
              Food Grade
            </li>
            <li
              class="px-3 py-1 rounded-full border border-gold/40 text-gold-light"
            >
              Feed Grade
            </li>
            <li
              class="px-3 py-1 rounded-full border border-gold/40 text-gold-light"
            >
              Bulk Supply
            </li>
          </ul>
          <a
            href="#contact"
            class="mt-6 inline-block text-sm font-semibold text-gold-light hover:text-gold transition"
            >Request Quote &rarr;</a
          >
        </div>
      </div>

      <!-- Pulses -->
      <div class="reveal rounded-3xl overflow-hidden bg-deep-700 card-hover">
        <img
          src="https://images.unsplash.com/photo-1612257999691-f16a537409e0?q=80&w=1600&auto=format&fit=crop"
          alt="Assorted pulses and lentils"
          class="w-full h-64 object-cover"
        />
        <div class="p-8">
          <h3 class="font-display text-2xl">Pulses</h3>
          <p class="mt-3 text-cotton/70 text-sm leading-relaxed">
            A dependable range including Toor Dal, Chana, Moong, Urad and
            Masoor, sourced and handled to consistent quality standards.
          </p>
          <ul
            class="mt-4 flex flex-wrap gap-2 text-xs font-mono-label uppercase"
          >
            <li
              class="px-3 py-1 rounded-full border border-gold/40 text-gold-light"
            >
              Toor Dal
            </li>
            <li
              class="px-3 py-1 rounded-full border border-gold/40 text-gold-light"
            >
              Chana
            </li>
            <li
              class="px-3 py-1 rounded-full border border-gold/40 text-gold-light"
            >
              Moong &middot; Urad &middot; Masoor
            </li>
          </ul>
          <a
            href="#contact"
            class="mt-6 inline-block text-sm font-semibold text-gold-light hover:text-gold transition"
            >Request Quote &rarr;</a
          >
        </div>
      </div>

      <!-- Food Grains -->
      <div class="reveal rounded-3xl overflow-hidden bg-deep-700 card-hover">
        <img
          src="https://images.unsplash.com/photo-1595475207225-428b62bda831?q=80&w=1600&auto=format&fit=crop"
          alt="Wheat and grain sacks in storage"
          class="w-full h-64 object-cover"
        />
        <div class="p-8">
          <h3 class="font-display text-2xl">Food Grains</h3>
          <p class="mt-3 text-cotton/70 text-sm leading-relaxed">
            Wheat, rice, sorghum, millets and other grains sourced from
            established domestic networks and supplied in bulk with quality
            assurance.
          </p>
          <ul
            class="mt-4 flex flex-wrap gap-2 text-xs font-mono-label uppercase"
          >
            <li
              class="px-3 py-1 rounded-full border border-gold/40 text-gold-light"
            >
              Wheat &middot; Rice
            </li>
            <li
              class="px-3 py-1 rounded-full border border-gold/40 text-gold-light"
            >
              Sorghum
            </li>
            <li
              class="px-3 py-1 rounded-full border border-gold/40 text-gold-light"
            >
              Millets
            </li>
          </ul>
          <a
            href="#contact"
            class="mt-6 inline-block text-sm font-semibold text-gold-light hover:text-gold transition"
            >Request Quote &rarr;</a
          >
        </div>
      </div>
    </div>
  </Container>
</section>
