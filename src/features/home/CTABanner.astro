---
import Container from "../../components/ui/Container.astro";
---

<section class="py-20 bg-gold relative overflow-hidden">
  <Container maxWidth="max-w-5xl" class="text-center reveal">
    <h2 class="font-display text-3xl lg:text-4xl font-medium text-deep-900">
      Ready to build a long-term supply partnership?
    </h2>
    <p class="mt-4 text-deep-900/75">
      Tell us your product, grade and quantity requirement — our team will
      respond with a detailed quotation.
    </p>
    <a
      href="#contact"
      class="mt-8 inline-block px-8 py-3.5 rounded-full bg-deep-900 text-cotton font-semibold text-sm hover:bg-deep-700 transition"
      >Request a Quote</a
    >
  </Container>
</section>
