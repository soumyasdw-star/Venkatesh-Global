---
import Container from "../../components/ui/Container.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";
---

<section class="py-24 bg-deep-700 text-cotton">
  <Container>
    <div class="max-w-2xl reveal">
      <SectionTitle
        label="Industries We Serve"
        title="Supplying across the agricultural value chain"
        titleClass="text-cotton"
      />
    </div>
    <div class="mt-12 flex flex-wrap gap-4">
      <span class="px-5 py-3 rounded-full border border-cotton/20 text-sm"
        >Textile Industry</span
      >
      <span class="px-5 py-3 rounded-full border border-cotton/20 text-sm"
        >Food Industry</span
      >
      <span class="px-5 py-3 rounded-full border border-cotton/20 text-sm"
        >Feed Industry</span
      >
      <span class="px-5 py-3 rounded-full border border-cotton/20 text-sm"
        >Agriculture</span
      >
      <span class="px-5 py-3 rounded-full border border-cotton/20 text-sm"
        >Commodity Traders</span
      >
      <span class="px-5 py-3 rounded-full border border-cotton/20 text-sm"
        >Importers</span
      >
      <span class="px-5 py-3 rounded-full border border-cotton/20 text-sm"
        >Exporters</span
      >
      <span class="px-5 py-3 rounded-full border border-cotton/20 text-sm"
        >Manufacturers</span
      >
    </div>
  </Container>
</section>
