---
import Container from "../../components/ui/Container.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";
---

<section class="py-28 lg:py-36 bg-cotton">
  <div
    class="max-w-7xl mx-auto px-6 lg:px-10 grid lg:grid-cols-2 gap-16 items-center"
  >
    <div class="reveal">
      <img
        src="https://images.unsplash.com/photo-1595231712325-9fedecef7575?q=80&w=1600&auto=format&fit=crop"
        alt="Quality inspection of raw cotton at a processing facility"
        class="rounded-3xl w-full h-[420px] object-cover"
      />
    </div>
    <div class="reveal">
      <SectionTitle
        label="Quality Assurance"
        title="Consistency is built at every stage"
      />
      <div class="mt-8 space-y-5">
        <div class="flex gap-4">
          <span class="w-2 h-2 mt-2 rounded-full bg-gold flex-shrink-0"
          ></span>
          <p class="text-ink/75">
            <span class="font-semibold text-deep">Strict sourcing</span>
            &mdash; commodities are selected from established, vetted growing regions.
          </p>
        </div>
        <div class="flex gap-4">
          <span class="w-2 h-2 mt-2 rounded-full bg-gold flex-shrink-0"
          ></span>
          <p class="text-ink/75">
            <span class="font-semibold text-deep">Quality inspection</span>
            &mdash; grading checks applied before dispatch.
          </p>
        </div>
        <div class="flex gap-4">
          <span class="w-2 h-2 mt-2 rounded-full bg-gold flex-shrink-0"
          ></span>
          <p class="text-ink/75">
            <span class="font-semibold text-deep">Proper storage</span>
            &mdash; warehousing designed to protect quality and shelf life.
          </p>
        </div>
        <div class="flex gap-4">
          <span class="w-2 h-2 mt-2 rounded-full bg-gold flex-shrink-0"
          ></span>
          <p class="text-ink/75">
            <span class="font-semibold text-deep">Professional packaging</span
            >
            &mdash; suited to both domestic transport and export handling.
          </p>
        </div>
        <div class="flex gap-4">
          <span class="w-2 h-2 mt-2 rounded-full bg-gold flex-shrink-0"
          ></span>
          <p class="text-ink/75">
            <span class="font-semibold text-deep">Timely delivery</span>
            &mdash; schedules planned and communicated clearly.
          </p>
        </div>
        <div class="flex gap-4">
          <span class="w-2 h-2 mt-2 rounded-full bg-gold flex-shrink-0"
          ></span>
          <p class="text-ink/75">
            <span class="font-semibold text-deep">Compliance</span> &mdash; with
            the specifications each customer requires.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
