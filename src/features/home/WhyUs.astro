---
import Container from "../../components/ui/Container.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";
---

<section id="why-us" class="py-28 lg:py-36 bg-cotton">
  <Container>
    <div class="max-w-2xl reveal">
      <SectionTitle
        label="Why Choose Us"
        title="What our partners rely on"
      />
    </div>
    <div class="mt-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <div
        class="reveal p-7 rounded-2xl bg-cotton-100 border border-black/5 card-hover"
      >
        <h3 class="font-display text-xl text-deep">Reliable Supply Chain</h3>
        <p class="mt-2 text-sm text-ink/65">
          Consistent sourcing networks that keep deliveries dependable through
          the season.
        </p>
      </div>
      <div
        class="reveal p-7 rounded-2xl bg-cotton-100 border border-black/5 card-hover"
      >
        <h3 class="font-display text-xl text-deep">
          Premium Product Quality
        </h3>
        <p class="mt-2 text-sm text-ink/65">
          Cotton bales and grains held to strict grading and inspection
          standards.
        </p>
      </div>
      <div
        class="reveal p-7 rounded-2xl bg-cotton-100 border border-black/5 card-hover"
      >
        <h3 class="font-display text-xl text-deep">Competitive Pricing</h3>
        <p class="mt-2 text-sm text-ink/65">
          Direct sourcing relationships that keep pricing fair and
          transparent.
        </p>
      </div>
      <div
        class="reveal p-7 rounded-2xl bg-cotton-100 border border-black/5 card-hover"
      >
        <h3 class="font-display text-xl text-deep">
          Strong Domestic Network
        </h3>
        <p class="mt-2 text-sm text-ink/65">
          Years of relationships with growers, mills and processors across
          India.
        </p>
      </div>
      <div
        class="reveal p-7 rounded-2xl bg-cotton-100 border border-black/5 card-hover"
      >
        <h3 class="font-display text-xl text-deep">Experienced Team</h3>
        <p class="mt-2 text-sm text-ink/65">
          Hands-on knowledge of commodity sourcing, grading and logistics.
        </p>
      </div>
      <div
        class="reveal p-7 rounded-2xl bg-cotton-100 border border-black/5 card-hover"
      >
        <h3 class="font-display text-xl text-deep">
          Ethical Business Practices
        </h3>
        <p class="mt-2 text-sm text-ink/65">
          Straightforward dealing with growers, buyers and partners alike.
        </p>
      </div>
      <div
        class="reveal p-7 rounded-2xl bg-cotton-100 border border-black/5 card-hover"
      >
        <h3 class="font-display text-xl text-deep">
          Export-Ready Operations
        </h3>
        <p class="mt-2 text-sm text-ink/65">
          Packaging and documentation processes aligned to international trade
          requirements.
        </p>
      </div>
      <div
        class="reveal p-7 rounded-2xl bg-cotton-100 border border-black/5 card-hover"
      >
        <h3 class="font-display text-xl text-deep">Customer Focus</h3>
        <p class="mt-2 text-sm text-ink/65">
          Responsive communication from first inquiry through after-sales
          support.
        </p>
      </div>
      <div
        class="reveal p-7 rounded-2xl bg-cotton-100 border border-black/5 card-hover"
      >
        <h3 class="font-display text-xl text-deep">
          Long-Term Relationships
        </h3>
        <p class="mt-2 text-sm text-ink/65">
          We measure success in repeat business and partnerships that last.
        </p>
      </div>
    </div>
  </Container>
</section>
